{
  "hosting": {
    "public": ".",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": [
      "firebase.json",
      "vercel.json",
      ".htaccess",
      "DEPLOYMENT.md",
      "supabase/**",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/portfolio/**",
        "destination": "/portfolio-project.html"
      }
    ]
  }
}
